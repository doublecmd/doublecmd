#: tdialogbox.lblAbout.caption
msgid "Zip plugin supports PKZIP-compatible, TAR, XZ, GZip, Zstandard and BZip2 data compression and archiving."
msgstr "Zip 插件支持 PKZIP 兼容、TAR、XZ、GZip、Zstandard 和 BZip2 数据压缩和归档."

